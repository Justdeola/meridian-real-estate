# Copy to .env.local for local overrides. On Vercel, set these in
# Project → Settings → Environment Variables (Production + Preview + Development).

VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=https://your-app.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional — in-memory cache is used when these are unset
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
